        <!-- Relationships -->
        <!-- sc (1) -> tech (N) -->
        <mxCell id="rel1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=1;strokeColor=#1F4E78;strokeWidth=1.5;" edge="1" parent="1" source="sc" target="tech"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- tech (1) -> skill (N) -->
        <mxCell id="rel2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=1;strokeColor=#1F4E78;strokeWidth=1.5;" edge="1" parent="1" source="tech" target="skill"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- sc (1) -> ticket (N) -->
        <mxCell id="rel3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=1;strokeColor=#1F4E78;strokeWidth=1.5;" edge="1" parent="1" source="sc" target="ticket"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="210"/><mxPoint x="400" y="210"/></Array></mxGeometry></mxCell>
        <!-- customers (1) -> ticket (N) -->
        <mxCell id="rel_cust" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=1;strokeColor=#2D662D;strokeWidth=1.5;" edge="1" parent="1" source="cust" target="ticket"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- tech (0..1) -> ticket (N) -->
        <mxCell id="rel4" value="0..1 : N" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=1;strokeColor=#1F4E78;strokeWidth=1.5;" edge="1" parent="1" source="tech" target="ticket"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- ticket (1) -> log (N) -->
        <mxCell id="rel5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=1;strokeColor=#1F4E78;strokeWidth=1.5;" edge="1" parent="1" source="ticket" target="log"><mxGeometry relative="1" as="geometry" /></mxCell>
        <!-- ticket (1) -> appt (N) -->
        <mxCell id="rel6" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;endArrow=ERmany;html=1;strokeColor=#1F4E78;strokeWidth=1.5;" edge="1" parent="1" source="ticket" target="appt"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- BẢNG CHÚ THÍCH KÝ HIỆU ERD (LEGEND BOX) -->
        <mxCell id="erd_legend" value="BẢNG CHÚ THÍCH KÝ HIỆU ERD (LEGEND):&#xa;• PK (Primary Key): Khóa chính nhân tạo tự tăng (SERIAL / BIGSERIAL), đảm bảo tính duy nhất và hiệu năng chỉ mục.&#xa;• FK (Foreign Key): Khóa ngoại liên kết toàn vẹn dữ liệu giữa các bảng (ON DELETE RESTRICT / CASCADE).&#xa;• UQ (Unique Constraint): Ràng buộc duy nhất trên các mã nghiệp vụ (customer_code, phone, ticket_code...).&#xa;• &lt;IDX&gt;: Composite Index tối ưu hóa truy vấn lọc danh sách và SLA due_date phục vụ yêu cầu phi chức năng NFR1 (&lt; 1.5s).&#xa;• 1 : N / 0..1 : N: Lực lượng quan hệ một-nhiều giữa các thực thể.&#xa;• Chuẩn hóa 3NF: Mọi thuộc tính không khóa phụ thuộc trực tiếp vào khóa chính, không phụ thuộc bắc cầu; hoàn toàn KHÔNG có bảng cô lập." style="text;html=1;strokeColor=#1F4E78;fillColor=#F9FBFD;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="670" y="470" width="460" height="190" as="geometry" />
        </mxCell>

        <!-- Khung chú thích tránh 5 lỗi ERD -->
        <mxCell id="erd_fixes" value="ĐỐI CHIẾU TRÁNH 5 LỖI ERD PHỔ BIẾN:&#xa;1. Không có bảng cô lập (Bổ sung customers nối với tickets).&#xa;2. Có bảng lịch sử trạng thái ticket_status_log riêng biệt.&#xa;3. Không lưu cột tính toán thừa (số ngày xử lý tính động).&#xa;4. Đánh index trên (technician_id, due_date ASC) cho NFR1.&#xa;5. Dùng khóa nhân tạo SERIAL làm PK, phone chỉ đặt UQ." style="text;html=1;strokeColor=#2D662D;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9.5;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="260" height="140" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>