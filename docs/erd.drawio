        <!-- Entity 5: tickets -->
        <mxCell id="ticket" value="tickets (Entity chính)&#xa;-----------------------------------&#xa;* ticket_id : SERIAL &lt;PK&gt;&#xa;ticket_code : VARCHAR(30) &lt;UQ&gt;&#xa;* customer_id : INT &lt;FK, IDX&gt;&#xa;* center_id : INT &lt;FK&gt;&#xa;technician_id : INT &lt;FK, Nullable, IDX&gt;&#xa;issue_category : VARCHAR(50)&#xa;issue_desc : TEXT&#xa;priority : VARCHAR(20)&#xa;status : VARCHAR(30) &lt;IDX&gt;&#xa;received_at : TIMESTAMPTZ&#xa;due_date : TIMESTAMPTZ &lt;IDX&gt;&#xa;closed_at : TIMESTAMPTZ" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;spacingLeft=10;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="340" y="240" width="250" height="230" as="geometry" />
        </mxCell>

        <!-- Entity 6: ticket_status_log -->
        <mxCell id="log" value="ticket_status_log (Lịch sử trạng thái)&#xa;-----------------------------------&#xa;* log_id : BIGSERIAL &lt;PK&gt;&#xa;* ticket_id : INT &lt;FK, IDX&gt;&#xa;from_status : VARCHAR(30)&#xa;to_status : VARCHAR(30)&#xa;from_technician_id : INT &lt;FK&gt;&#xa;to_technician_id : INT &lt;FK&gt;&#xa;reason : TEXT&#xa;note : TEXT&#xa;changed_by : INT&#xa;changed_at : TIMESTAMPTZ" style="shape=rect;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacingLeft=10;fontSize=9.5;" vertex="1" parent="1">
