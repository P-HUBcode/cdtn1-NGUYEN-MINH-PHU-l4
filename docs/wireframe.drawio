        <!-- M1 Window -->
        <mxCell id="m1_win" value="M1: Màn hình Danh sách chờ phân công &amp; Tải công việc KTV" style="swimlane;whiteSpace=wrap;html=1;startSize=25;fillColor=#f5f5f5;fontStyle=1;" vertex="1" parent="1">
